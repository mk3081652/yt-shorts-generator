# Gemini API (Free at https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-flash-latest
GEMINI_THINKING_LEVEL=low
VISION_QA=0

# Cloudflare Workers AI - FLUX.1 [schnell] (10,000 free daily neurons)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
FLUX_MODEL=@cf/black-forest-labs/flux-1-schnell
FLUX_STEPS=4
FLUX_TIMEOUT=45
FLUX_COOLDOWN_SECONDS=900

# Server Security & CORS
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
PORT=8000
