# Gemini API Key for Visual Director AI & Scene Storyboard Planning
# Get your free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-flash-latest

# Cloudflare Workers AI FLUX.1-schnell (for Auto AI Image Generation)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
FLUX_MODEL=@cf/black-forest-labs/flux-1-schnell
FLUX_TIMEOUT=45
FLUX_COOLDOWN_SECONDS=900

# Vision QA Validation (0=disabled, 1=enabled)
VISION_QA=0

# Allowed CORS Origins (Optional - comma separated)
# ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
