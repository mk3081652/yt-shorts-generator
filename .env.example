# ==============================================================================
# YT Shorts AI Studio - Environment Configuration
# ==============================================================================

# LLM Script & Storyboard Director (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-flash-latest
GEMINI_THINKING_LEVEL=low
VISION_QA=0

# AI Image Generation (Cloudflare Workers AI - FLUX Schnell)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
FLUX_MODEL=@cf/black-forest-labs/flux-1-schnell
FLUX_STEPS=4
FLUX_TIMEOUT=45
FLUX_COOLDOWN_SECONDS=900

# Premium Neural TTS & Audio (Optional - defaults to high-retention Edge-TTS)
# Options: edge | elevenlabs | openai
TTS_PROVIDER=edge
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
OPENAI_API_KEY=

# Visual & Motion Styling
# Options: film_grain | none
MOTION_TEXTURE=film_grain
TRANSITION_STYLE=crossfade

# Remote Cloud Artifact Storage (Optional - defaults to local /outputs)
# Options: local | s3 | cloudinary | supabase
STORAGE_PROVIDER=local
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
CLOUDINARY_URL=
SUPABASE_URL=
SUPABASE_KEY=

# Server Configuration
PORT=8000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
